# ==============================================================================
# MOG Production Environment Configuration
# ==============================================================================
# Для применения скопируйте данный файл в .env:
#   cp .env.prod.example .env
# и заполните реальные значения перед запуском:
#   docker compose -f docker-compose-production.yml up -d --build

# ------------------------------------------------------------------------------
# Домен и Caddy (SSL)
# ------------------------------------------------------------------------------
# Укажите ваш рабочий домен (например, mog.example.com или stoloto-mog.ru).
# Caddy автоматически запросит и настроит бесплатный валидный SSL-сертификат
# (Let's Encrypt / ZeroSSL) при наличии DNS A/AAAA записи на этот сервер.
# Для локальной проверки можно оставить localhost (будет использован внутренний TLS).
DOMAIN=example.com

# ------------------------------------------------------------------------------
# База данных PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=mog_db
POSTGRES_USER=mog_user
# ОБЯЗАТЕЛЬНО укажите надежный пароль для продакшена!
POSTGRES_PASSWORD=replace_with_a_strong_password_in_production

# ------------------------------------------------------------------------------
# Quarkus Backend
# ------------------------------------------------------------------------------
# Секретный ключ для подписи и верификации JWT (минимум 256 бит / 32+ символов)
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_at_least_256_bits_long!

# ------------------------------------------------------------------------------
# Docker Images (опционально)
# ------------------------------------------------------------------------------
POSTGRES_IMAGE=dockerhub.timeweb.cloud/library/postgres:16-alpine
CADDY_IMAGE=caddy:2-alpine
