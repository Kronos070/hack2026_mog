#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Startup Batch script
# ----------------------------------------------------------------------------

set -e

# OS specific support.
cygwin=false;
darwin=false;
case "`uname`" in
  CYGWIN*) cygwin=true ;;
  Darwin*) darwin=true ;;
esac

if [ -z "$JAVA_HOME" ] ; then
  if $darwin ; then
    if [ -x '/usr/libexec/java_home' ] ; then
      JAVA_HOME=`/usr/libexec/java_home` || true
    fi
    if [ -z "$JAVA_HOME" ] && [ -d "/Library/Java/JavaVirtualMachines/temurin-26.jdk/Contents/Home" ] ; then
      JAVA_HOME="/Library/Java/JavaVirtualMachines/temurin-26.jdk/Contents/Home"
    fi
  fi
fi

if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
    JAVACMD="$JAVA_HOME/jre/sh/java"
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi
else
  JAVACMD="`which java`"
fi

if [ ! -x "$JAVACMD" ] ; then
  echo "Error: JAVA_HOME is not defined correctly." >&2
  echo "  We cannot execute $JAVACMD" >&2
  exit 1
fi

PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done

BASE_DIR=`dirname "$PRG"`
BASE_DIR=`cd "$BASE_DIR" >/dev/null; pwd`

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$BASE_DIR}"

WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROP="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"

# Provide fallback to system mvn if wrapper jar is not downloaded yet and mvn exists
if [ ! -f "$WRAPPER_JAR" ]; then
  if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
  fi
  echo "Downloading Maven Wrapper..."
  JAR_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  if command -v curl >/dev/null 2>&1; then
    curl -fL -o "$WRAPPER_JAR" "$JAR_URL" || true
  fi
fi

exec "$JAVACMD" \
  -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
  -Dnet.bytebuddy.experimental=true \
  -cp "$WRAPPER_JAR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
