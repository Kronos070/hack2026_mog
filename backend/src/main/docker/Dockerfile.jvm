FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /work
COPY pom.xml mvnw ./
COPY .mvn .mvn
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B || true
COPY src src
RUN ./mvnw clean package -DskipTests

FROM eclipse-temurin:21-jre-jammy
WORKDIR /work
COPY --from=build /work/target/quarkus-app/lib/ /work/lib/
COPY --from=build /work/target/quarkus-app/*.jar /work/
COPY --from=build /work/target/quarkus-app/app/ /work/app/
COPY --from=build /work/target/quarkus-app/quarkus/ /work/quarkus/

EXPOSE 8080
ENV JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
CMD ["sh", "-c", "java $JAVA_OPTS -jar /work/quarkus-run.jar"]
