            font-size: 14px;
            font-weight: 600;
            padding: 6px 16px;
            border-radius: 9999px;
            margin-bottom: 20px;
        }
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #34d399;
            box-shadow: 0 0 8px #34d399;
        }
        h1 {
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 10px 0;
            color: #f1f5f9;
        }
        p {
            color: #94a3b8;
            font-size: 15px;
            line-height: 1.6;
            margin: 0 0 24px 0;
        }
        .endpoints {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 10px;
