{
    # В Caddy автоматическое получение и продление SSL-сертификатов (Let's Encrypt / ZeroSSL)
    # работает по умолчанию для любых публичных доменов.
    # Опционально: если хотите получать уведомления об окончании сертификатов от Let's Encrypt:
    # email your-email@domain.com
}

{$DOMAIN:localhost} {
    # Сжатие ответов (gzip, zstd)
    encode zstd gzip

    # Проксирование REST API на бэкенд
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Проксирование WebSockets на бэкенд (/ws, /ws/game и т.д.)
    handle /ws* {
        reverse_proxy backend:8080
    }

    # Документация OpenAPI и Swagger UI от Quarkus (/q/swagger-ui, /q/openapi)
    handle /q/* {
        reverse_proxy backend:8080
    }

    # Черновой ответ-заглушка вместо фронтенда (Caddy is working)
    handle {
        header Content-Type "text/html; charset=utf-8"
        respond <<HTML
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOG Service - Caddy is working</title>
    <style>
        body {
            margin: 0;
            padding: 0;
